    def dohvati_trening(self, dio_tijela):
        dio_tijela = dio_tijela.lower()

        if dio_tijela in self.vjezbe:
            rezultat = f"TRENING ZA {dio_tijela.upper()}\n\n"

            for vjezba in self.vjezbe[dio_tijela]:
                rezultat += vjezba.prikazi() + "\n"

            return rezultat

        else:
            return "Nepostojeci dio tijela. Pokusaj: prsa, leđa, noge, ramena, ruke ili trbuh."


# GUI APLIKACIJA

trening = Trening()


# Funkcija za prikaz treninga
def prikazi_trening():
    dio = entry_dio.get().strip()

    if dio == "":
        text_rezultat.delete(1.0, tk.END)
        text_rezultat.insert(tk.END, "Upisi dio tijela.")
        return

    rezultat = trening.dohvati_trening(dio)

    text_rezultat.delete(1.0, tk.END)
    text_rezultat.insert(tk.END, rezultat)


# Glavni prozor
root = tk.Tk()
root.title("Fitness aplikacija")
root.geometry("600x500")
root.configure(bg="#1e1e1e")


# Naslov
label_naslov = tk.Label(
    root,
    text="FITNESS TRENING APLIKACIJA",
    font=("Arial", 18, "bold"),
    bg="#1e1e1e",
    fg="white"
)
label_naslov.pack(pady=15)


# Upute
label_upute = tk.Label(
    root,
    text="Upisi dio tijela: prsa, leđa, noge, ramena, ruke, trbuh ili kardio",
    font=("Arial", 11),
    bg="#1e1e1e",
    fg="white"
)
label_upute.pack()


# Input
entry_dio = tk.Entry(root, font=("Arial", 14), width=30)
entry_dio.pack(pady=10)


# Gumb
btn_prikazi = tk.Button(
    root,
    text="Prikazi trening",
    font=("Arial", 12, "bold"),
    bg="#4CAF50",
    fg="white",
    command=prikazi_trening
)
btn_prikazi.pack(pady=10)


# Text box za rezultat
text_rezultat = tk.Text(
    root,
    height=18,
    width=60,
    font=("Arial", 11)
)
text_rezultat.pack(pady=10)


# Pokretanje aplikacije
root.mainloop()













































