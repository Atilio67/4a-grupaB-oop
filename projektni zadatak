# Fitness aplikacija u Pythonu (Tkinter GUI)


import tkinter as tk


class Vjezba:
    def __init__(self, naziv, misicna_skupina, ponavljanja):
        self.naziv = naziv
        self.misicna_skupina = misicna_skupina
        self.ponavljanja = ponavljanja

    def prikazi(self):
        return f"- {self.naziv} ({self.ponavljanja})"


